{
	"trailingSlash": "auto",
	"routes": [
		{
			"route": "/",
			"redirect": "/cv",
			"allowedRoles": ["authenticated"]
		},
		{
			"route": "/cv",
			"rewrite": "cv.html",
			"allowedRoles": ["authenticated"]
		}
	],
	"responseOverrides": {
		"401": {
			"redirect": "/.auth/login/github?post_login_redirect_uri=.referrer",
			"statusCode": 302
		}
	}
}
